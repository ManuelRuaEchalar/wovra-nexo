# Copiar a .env y completar. Nunca subir .env al repositorio.
PORT=8787
# En Railway se deduce sola del dominio público (RAILWAY_PUBLIC_DOMAIN).
URL_PUBLICA=http://localhost:8787

# Trustless Work (testnet): pedir la clave en https://dapp.trustlesswork.com → Settings → API Keys
TW_API_URL=https://dev.api.trustlesswork.com
TW_API_KEY=

# Pollar (testnet): clave publicable pub_testnet_… de https://dashboard.pollar.xyz
POLLAR_CLAVE_PUBLICA=

# Opcional: clave secreta S… de la cuenta de plataforma. Si falta, se genera una de testnet en datos/.
PLATAFORMA_SECRETA=
# Opcional: clave secreta S… del fondo que paga a los nodos. Si falta, se genera una de testnet en datos/.
FONDO_SECRETA=

TASA_BS_POR_USDC=6.96
MAX_RECOMPENSA_USDC=50
