<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base sin ActionBar; Compose aplica el sistema Halo + Nocturno.
         El fondo evita el parpadeo blanco al abrir. -->
    <style name="Theme.Dendra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Dendra.Night" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/noche</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Dendra.Black" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
