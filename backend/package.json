{
  "name": "dendra-backend",
  "version": "1.0.0",
  "description": "API de Dendra: recompensas en escrow (Trustless Work), micropagos a nodos y panel web, sobre Stellar testnet",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
